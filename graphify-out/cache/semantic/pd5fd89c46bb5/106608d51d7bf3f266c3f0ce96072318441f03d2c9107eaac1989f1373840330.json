{"nodes": [{"id": "web_prompts_invoice_generator_invoice_generator_ui", "label": "Invoice Generator UI Component (spec)", "file_type": "concept", "source_file": "web/prompts/invoice-generator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built as a self-contained, client-only component to be dropped into an existing host project; routing, bundling and deployment are the host's responsibility."}, {"id": "web_prompts_invoice_generator_currency_handling", "label": "Multi-Currency Formatting (no conversion)", "file_type": "concept", "source_file": "web/prompts/invoice-generator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Currency selection changes only symbol and number formatting and never auto-converts amounts, avoiding dependence on an exchange-rate service and preventing silent mutation of entered figures. Default is PHP."}, {"id": "web_prompts_invoice_generator_line_items", "label": "Line Items Table", "file_type": "concept", "source_file": "web/prompts/invoice-generator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "amount = unitCost x quantity, recomputed instantly, negative numbers rejected, unlimited rows."}, {"id": "web_prompts_invoice_generator_blank_item_filtering", "label": "Blank Line Item Filtering", "file_type": "rationale", "source_file": "web/prompts/invoice-generator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An item with empty description, or zero/empty unit cost, or zero/empty quantity is excluded from subtotal, from render and from the PDF; called out as critical because the artifact is a printed document where empty rows are visible defects."}, {"id": "web_prompts_invoice_generator_calculation_logic", "label": "Invoice Calculation Logic", "file_type": "concept", "source_file": "web/prompts/invoice-generator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "subtotal = sum of non-blank item amounts; taxAmount = subtotal * tax/100; total = subtotal + taxAmount - discount + shipping. Tax is a percentage while discount and shipping are fixed amounts."}, {"id": "web_prompts_invoice_generator_pdf_generation", "label": "Client-Side PDF Generation And Download", "file_type": "concept", "source_file": "web/prompts/invoice-generator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Validate, filter blanks, render a print-ready layout with no input fields visible, then download as Invoice-<invoice-number>.pdf via a browser-safe library (html2pdf, jsPDF or equivalent) so no backend is required."}, {"id": "web_prompts_invoice_generator_logo_upload", "label": "Logo Upload With Preview", "file_type": "concept", "source_file": "web/prompts/invoice-generator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Restricted to JPG/JPEG/PNG under 5MB to keep the embedded PDF payload small."}], "edges": [{"source": "web_prompts_invoice_generator_invoice_generator_ui", "target": "web_prompts_invoice_generator_line_items", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "web/prompts/invoice-generator.md", "source_location": null, "weight": 1.0}, {"source": "web_prompts_invoice_generator_invoice_generator_ui", "target": "web_prompts_invoice_generator_currency_handling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "web/prompts/invoice-generator.md", "source_location": null, "weight": 1.0}, {"source": "web_prompts_invoice_generator_invoice_generator_ui", "target": "web_prompts_invoice_generator_logo_upload", "relation": "references"