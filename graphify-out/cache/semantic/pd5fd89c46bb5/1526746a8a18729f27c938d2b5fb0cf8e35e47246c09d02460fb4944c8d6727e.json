{"nodes": [{"id": "mobile_src_modules_grocery_presentation_design_notes_app_minimalist", "label": "Notes-App Minimalist Direction", "file_type": "rationale", "source_file": "mobile/src/modules/grocery/presentation/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "iOS-Notes calm in Broadsheet's newsprint voice: one flat paper ground (no cards, no shadows, no rounded containers), serif everywhere as the chrome, one accent color, one straight list, and generous air that must not be tightened."}, {"id": "mobile_src_modules_grocery_presentation_design_broadsheet_tokens", "label": "Broadsheet Token Palette", "file_type": "concept", "source_file": "mobile/src/modules/grocery/presentation/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "theme/notebook.ts is the single source mirrored into tailwind.config.js. A separate accentText (#006786) exists because the base cyan (#0088b0) only clears 3:1 contrast \u2014 fine for icons and fills, not for body copy."}, {"id": "mobile_src_modules_grocery_presentation_design_source_serif_4", "label": "Source Serif 4 App-Wide Type", "file_type": "concept", "source_file": "mobile/src/modules/grocery/presentation/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loaded via expo-font and set as the default Text family, replacing the system sans entirely. Emphasis and captions must use the true italic, never a synthesized oblique."}, {"id": "mobile_src_modules_grocery_presentation_design_single_straight_list", "label": "Single Straight List (no tab split)", "file_type": "rationale", "source_file": "mobile/src/modules/grocery/presentation/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The To Get / Checked tab split is deleted; checked items stay in place struck through and greyed. Any surviving filter moves to a bottom-toolbar funnel icon rather than a top tab bar."}, {"id": "mobile_src_modules_grocery_presentation_design_checkbox", "label": "Checkbox Reskin (highest leverage)", "file_type": "concept", "source_file": "mobile/src/modules/grocery/presentation/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Done first because it propagates to every list and the session at once. Rounded square ~24x24, inkFaint 2px border unchecked, solid accent fill with white check when checked; the color prop's green branch is deleted since there is now one accent."}, {"id": "mobile_src_modules_grocery_presentation_design_itemrowcontent", "label": "ItemRowContent Reskin", "file_type": "concept", "source_file": "mobile/src/modules/grocery/presentation/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checked state applies line-through and inkFaint to both name and meta; price uses tabular figures, right-aligned, keeping the peso sign."}, {"id": "mobile_src_modules_grocery_presentation_design_groceryitemrow", "label": "GroceryItemRow Reskin", "file_type": "concept", "source_file": "mobile/src/modules/grocery/presentation/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Row backgrounds and rounded corners removed in favor of hairline separators on paper; the whole row becomes the check target with long-press still deleting, and the always-visible red trash icon is dropped because no red is allowed."}, {"id": "mobile_src_modules_grocery_presentation_design_categorygroup", "label": "CategoryGroup #tag Headers", "file_type": "concept", "source_file": "mobile/src/modules/grocery/presentation/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gray pill headers become flush-left cyan #tags with a chevron and no background fill; isCollapsed state and collapseStamp behaviour stay untouched so this is purely visual."}, {"id": "mobile_src_modules_grocery_presentation_design_additeminput", "label": "AddItemInput Reskin", "file_type": "concept", "source_file": "mobile/src/modules/grocery/presentation/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "surface fill, hairline border, radius 2, cyan + glyph, italic inkSoft placeholder; suggestion rows lose the indigo highlight in favour of a faint surface fill."}, {"id": "mobile_src_modules_grocery_presentation_design_groceryheader", "label": "GroceryHeader Reskin", "file_type": "concept", "source_file": "mobile/src/modules/grocery/presentation/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Serif 32 title with a #tag + count subline; the filled indigo Shop pill becomes a cyan outline or text button and the friends-badge red dot becomes cyan."}, {"id": "mobile_src_modules_grocery_presentation_design_sessionbanner", "label": "SessionBanner Status Caption", "file_type": "concept", "source_file": "mobile/src/modules/grocery/presentation/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The green progress bar is replaced by a one-line caption '{done} of {total} \u00b7 \u20b1{spend} so far' in inkSoft, removing the second accent color while keeping the same information."}, {"id": "mobile_src_modules_grocery_presentation_design_presentation_only_reskin", "label": "Presentation-Only Reskin Boundary", "file_type": "rationale", "source_file": "mobile/src/modules/grocery/presentation/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "hooks, contexts/SyncProvider, infrastructure and domain are explicitly untouched; collapse state, the session state machine and the invitations flow are unchanged. The redesign is scoped strictly to the presentation layer."}], "edges": [{"source": "mobile_src_modules_grocery_presentation_design_notes_app_minimalist", "target": "mobile_src_modules_grocery_presentation_design_broadsheet_tokens", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mobile/src/modules/grocery/presentation/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "mobile_src_modules_grocery_presentation_design_notes_app_minimalist", "target": "mobile_src_modules_grocery_presentation_design_source_serif_4", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mobile/src/modules/grocery/presentation/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "mobile_src_modules_grocery_presentation_design_notes_app_minimalist", "target": "mobile_src_modules_grocery_presentation_design_single_straight_list", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mobile/src/modules/grocery/presentation/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "mobile_src_modules_grocery_presentation_design_checkbox", "target": "mobile_src_modules_grocery_presentation_design_broadsheet_tokens", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mobile/src/modules/grocery/presentation/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "mobile_src_modules_grocery_presentation_design_itemrowcontent", "target": "mobile_src_modules_grocery_presentation_design_broadsheet_tokens", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mobile/src/modules/grocery/presentation/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "mobile_src_modules_groce