{"nodes": [{"id": "mobile_grocery_plan_two_route_navigation", "label": "Two-Route Grocery Navigation", "file_type": "rationale", "source_file": "mobile/GROCERY_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separate grocery.tsx, grocery/[listId].tsx and grocery/session.tsx routes are more idiomatic on mobile than the web's single-screen mobileView toggle."}, {"id": "mobile_grocery_plan_hooks_port", "label": "Grocery Hooks Port (web to mobile)", "file_type": "concept", "source_file": "mobile/GROCERY_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seven hooks ported with four mechanical substitutions: useAuth import path, Logger to getLogger, toast.error to Alert.alert, and repository imports pointed at @himan/shared/grocery. queryKeys.ts is copied verbatim so cache keys stay identical across platforms."}, {"id": "mobile_grocery_plan_component_ports", "label": "Web-to-RN Grocery Component Mapping", "file_type": "concept", "source_file": "mobile/GROCERY_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "15 web components map one-to-one to RN equivalents; Dialog becomes Modal, CSS width% progress becomes a nested View with an inline width style, and web context menus become long-press bottom modals (cross-platform, simpler than ActionSheetIOS)."}, {"id": "mobile_grocery_plan_modal_pattern", "label": "RN Slide-Up Modal Pattern", "file_type": "concept", "source_file": "mobile/GROCERY_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Modal animationType=slide transparent, with a Pressable black/40 backdrop above a rounded-t-2xl sheet \u2014 one shape reused by every grocery modal."}, {"id": "mobile_grocery_plan_queryclient_placement", "label": "QueryClientProvider Placement Decision", "file_type": "rationale", "source_file": "mobile/GROCERY_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Placed in app/(app)/_layout.tsx (the protected layout) rather than the root layout, so grocery screens share one cache while auth screens, which need no query cache, stay outside it."}, {"id": "mobile_grocery_plan_realtime_lifecycle", "label": "Realtime Lifecycle in React Native", "file_type": "rationale", "source_file": "mobile/GROCERY_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "useGroceryRealtime's useEffect-with-cleanup works identically on RN; Supabase handles reconnection on app foreground automatically, so no extra AppState wiring was needed for realtime."}], "edges": [{"source": "mobile_grocery_plan_hooks_port", "target": "mobile_claude_tanstack_query", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mobile/GROCERY_PLAN.md", "source_location": null, "weight": 1.0}, {"source": "mobile_grocery_plan_hooks_port", "target": "claude_shared_package", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mobile/GROCERY_PLAN.md", "source_location": null, "weight": 1.0}, {"source": "mobile_grocery_plan_hooks_port", "target": "mobile_google_signin_plan_authprovider", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mobile/GROCERY_PLAN.md", "source_location": null, "weight": 1.0}, {"source": "mobile_grocery_plan_queryclient_placement", "target": "mobile_grocery_plan_hooks_port", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mobile/GROCERY_PLAN.md", "source_location": null, "weight": 1.0}, {"source": "mobile_grocery_plan_realtime_lifecycle", "target": "mobile_claude_realtime", "relation": "rationale_for", "confidence"