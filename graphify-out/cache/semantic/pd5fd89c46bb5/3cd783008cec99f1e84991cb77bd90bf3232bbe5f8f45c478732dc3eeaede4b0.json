{"nodes": [{"id": "mobile_cards_plan_cards_module", "label": "Mobile Cards Module Plan", "file_type": "document", "source_file": "mobile/CARDS_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reimplements web's sidebar+grid cards UI with mobile-native affordances while reusing shared repositories and entities unchanged."}, {"id": "mobile_cards_plan_react_native_quick_crypto", "label": "react-native-quick-crypto Polyfill", "file_type": "rationale", "source_file": "mobile/CARDS_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CardEncryptionService depends on crypto.subtle (AES-GCM, PBKDF2), which RN 0.81/Hermes does not fully support. A JSI-based polyfill imported at the very top of app/_layout.tsx fixes this; viable because the project already uses native builds via expo run:ios rather than Expo Go."}, {"id": "mobile_cards_plan_cardencryptionservice", "label": "CardEncryptionService", "file_type": "concept", "source_file": "mobile/CARDS_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "mobile_cards_plan_mobile_ux_adaptation", "label": "Cards Mobile UX Adaptation", "file_type": "rationale", "source_file": "mobile/CARDS_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sidebar becomes horizontal chips, grid becomes a FlatList of compact rows, detail becomes an iOS pageSheet bottom sheet, and add/edit becomes a full-screen form because dialogs are poor on mobile. Category management moves to long-press on a chip."}, {"id": "mobile_cards_plan_usecards", "label": "useCards Hook", "file_type": "concept", "source_file": "mobile/CARDS_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mirrors the grocery hook pattern: React Query over CreditCardRepository, Alert.alert on error, getLogger(), and filter stabilization via useMemo on individual filter properties (borrowed from web). Skips useSubscription checks since mobile has no subscription gating yet."}, {"id": "mobile_cards_plan_carddetailsheet", "label": "CardDetailSheet", "file_type": "concept", "source_file": "mobile/CARDS_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "mobile_cards_plan_cardformscreen", "label": "CardFormScreen", "file_type": "concept", "source_file": "mobile/CARDS_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One reusable full-screen form serving both cards/add.tsx and cards/[cardId].tsx; selects render as chips or a modal picker rather than adding a third-party picker dependency."}, {"id": "mobile_cards_plan_luhn_validation", "label": "Luhn Card Number Validation", "file_type": "concept", "source_file": "mobile/CARDS_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Copied verbatim from web CardDialog.tsx so validation behaviour stays identical across platforms."}], "edges": [{"source": "mobile_cards_plan_cards_module", "target": "mobile_cards_plan_react_native_quick_crypto", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mobile/CARDS_PLAN.md", "source_location": null, "weight": 1.0}, {"source": "mobile_cards_plan_react_native_quick_crypto", "target": "mobile_cards_plan_cardencryptionservice", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mobile/CARDS_PLAN.md", "source_location": null, "weight": 1.0}, {"source": "mobile_cards_plan_usecards", "target": "mobile_claude_tanstack_query", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "sour