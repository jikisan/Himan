{"nodes": [{"id": "docs_superpowers_plans_2026_08_01_grocery_friends_friendships_table", "label": "friendships Table Migration", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-01-grocery-friends.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UNIQUE (requester_id, addressee_id) plus CHECK (requester_id <> addressee_id) enforce at the DB level what the RPC also checks; indexes on both id columns because queries run in both directions."}, {"id": "docs_superpowers_plans_2026_08_01_grocery_friends_send_friend_request", "label": "send_friend_request RPC", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-01-grocery-friends.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raises USER_NOT_FOUND, CANNOT_FRIEND_SELF, ALREADY_FRIENDS or REQUEST_ALREADY_PENDING. A previously declined row is revived by rewriting requester/addressee and resetting status to pending, so a re-send after a decline is allowed without violating the unique constraint."}, {"id": "docs_superpowers_plans_2026_08_01_grocery_friends_get_friends", "label": "get_friends RPC", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-01-grocery-friends.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns accepted rows joined twice against auth.users so both emails come back in one query, avoiding per-row email lookups on the client."}, {"id": "docs_superpowers_plans_2026_08_01_grocery_friends_get_friend_requests", "label": "get_friend_requests RPC", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-01-grocery-friends.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns pending rows in both directions; the client derives incoming vs outgoing from mapFriendRow rather than the server splitting them."}, {"id": "docs_superpowers_plans_2026_08_01_grocery_friends_mapfriendrow", "label": "mapFriendRow (pure row mapper)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-01-grocery-friends.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure function computing the friend's identity and direction relative to currentUserId; isolating this makes the domain testable via Vitest with no Supabase involved."}, {"id": "docs_superpowers_plans_2026_08_01_grocery_friends_friendrepository", "label": "FriendRepository", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-01-grocery-friends.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cancelRequest and remove issue the identical DELETE but are kept as distinct method names for caller clarity; accept/decline update status and rely on the addressee-only UPDATE policy for authorization rather than re-checking in code."}, {"id": "docs_superpowers_plans_2026_08_01_grocery_friends_friendlyerror", "label": "friendlyError Postgres Exception Mapper", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-01-grocery-friends.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Substring-matches raised Postgres exception codes onto user-facing sentences, keeping error copy in the repository instead of the UI."}, {"id": "docs_superpowers_plans_2026_08_01_grocery_friends_usefriends", "label": "useFriends Hook", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-01-grocery-friends.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two React Query queries plus five mutations that all funnel through one invalidate(); incoming/outgoing are derived client-side by filtering on direction. Placed under the grocery hooks dir even though the domain module is standalone."}, {"id": "docs_superpowers_plans_2026_08_01_grocery_friends_friendpicker", "label": "FriendPicker Component", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-01-grocery-friends.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renders nothing when no eligible friends remain, filters out excludeUserIds (existing members), and delegates entirely to the caller's onPick \u2014 so it adds no share plumbing and no new RLS."}, {"id": "docs_superpowers_plans_2026_08_01_grocery_friends_friendsscreen", "label": "Friends Screen (/friends route)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-01-grocery-friends.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four sections: add-by-email, incoming requests (accept/decline), outgoing (cancel), friends (remove). Expo Router auto-registers the route from the file path."}, {"id": "docs_superpowers_plans_2026_08_01_grocery_friends_header_entry_point", "label": "Grocery Header Friends Entry Point", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-01-grocery-friends.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "People icon in GroceryHeader routing to /friends, with a red badge showing incomingRequests.length \u2014 the only surfacing of pending requests since friends have no realtime channel."}], "edges": [{"source": "docs_superpowers_plans_2026_08_01_grocery_friends_friendships_table", "target": "docs_superpowers_specs_2026_08_01_grocery_friends_design_mutual_friend_graph", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-08-01-grocery-frien