{"nodes": [{"id": "passwords_mobile_plan_passwords_module", "label": "Mobile Passwords Module Plan", "file_type": "document", "source_file": "PASSWORDS_MOBILE_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ports the web PasswordsPage to mobile by copying the cards module structure verbatim, because cards already solved bottom-sheet, form-keyboard and category-chip patterns on React Native."}, {"id": "passwords_mobile_plan_safe_area_insets", "label": "Safe Area Inset Conventions", "file_type": "rationale", "source_file": "PASSWORDS_MOBILE_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always use useSafeAreaInsets() rather than hardcoding device spacing; a table maps each scenario (full screen, sheet footer, sheet ScrollView, FAB, top toast, keyboard form) to a specific padding formula."}, {"id": "passwords_mobile_plan_usepasswords", "label": "usePasswords Hook", "file_type": "concept", "source_file": "PASSWORDS_MOBILE_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mirrors useCards: useQuery over PasswordRepository.findAll(filters, userId), mutations for create/update/delete/toggleFavorite, all invalidating passwordsKeys.passwords(), errors via Alert.alert plus getLogger().error()."}, {"id": "passwords_mobile_plan_usepasswordcategories", "label": "usePasswordCategories Hook", "file_type": "concept", "source_file": "PASSWORDS_MOBILE_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "deleteCategory must also invalidate passwordsKeys.passwords() because passwords hold a dangling category reference after their category is removed."}, {"id": "passwords_mobile_plan_passworddetailsheet", "label": "PasswordDetailSheet", "file_type": "concept", "source_file": "PASSWORDS_MOBILE_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Password masked by default with an eye toggle to reveal; URL opening guarded by isValidUrl() before Linking.openURL; footer padding from useSafeAreaInsets().bottom; max height 88% of screen."}, {"id": "passwords_mobile_plan_passwordlistitem", "label": "PasswordListItem", "file_type": "concept", "source_file": "PASSWORDS_MOBILE_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Password is never revealed in the list (always dots) \u2014 reveal only happens in the detail sheet. Copy uses expo-clipboard and fires an onCopied callback so the parent screen owns the toast."}, {"id": "passwords_mobile_plan_passwordformscreen", "label": "PasswordFormScreen", "file_type": "concept", "source_file": "PASSWORDS_MOBILE_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single component serving both add and edit routes via an optional passwordId prop. Layout is SafeAreaView -> KeyboardAvoidingView -> ScrollView, same as CardFormScreen."}, {"id": "passwords_mobile_plan_password_generator", "label": "Rejection-Sampling Password Generator", "file_type": "rationale", "source_file": "PASSWORDS_MOBILE_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ports web's crypto.getRandomValues rejection-sampling approach (16 chars, upper+lower+digits+symbols) specifically to avoid modulo bias; works on RN because react-native-quick-crypto polyfills crypto globally."}, {"id": "passwords_mobile_plan_encryptionservice", "label": "Shared EncryptionService (AES-GCM)", "file_type": "concept", "source_file": "PASSWORDS_MOBILE_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client-side AES-GCM encryption reused unchanged from the shared package; mobile only needed react-native-quick-crypto to make the Web Crypto surface available."}, {"id": "passwords_mobile_plan_categorychips", "label": "Passwords CategoryChips", "file_type": "concept", "source_file": "PASSWORDS_MOBILE_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Copied from cards/CategoryChips with CardCategoryType swapped for CategoryType; All / Favorites / per-category (long-press to edit) / +Add dashed chip."}], "edges": [{"source": "passwords_mobile_plan_passwords_module", "target": "mobile_cards_plan_cards_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PASSWORDS_MOBILE_PLAN.md", "source_location": null, "weight": 1.0}, {"source": "passwords_mobile_plan_passwords_module", "target": "claude_module_scaffolding_recipe", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "PASSWORDS_MOBILE_PLAN.md", "source_location": null, "weight": 1.0}, {"source": "passwords_mobile_plan_usepasswords", "target": "mobile_cards_plan_usecards", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PASSWORDS_MOBILE_PLAN.md", "source_location": null, "weight": 1.0}, {"source": "passwords_mobile_plan_usepasswordcategories", "target": "passwords_mobile_plan_usepasswords", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PASSWORDS_MOBILE_PLAN.md", "source_location": null, "weight": 1.0}, {"source": "passwords_mobile_plan_passworddetailsheet", "target": "mobile_cards_plan_carddetailsheet", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PASSWORDS_MOBILE_PLAN.md", "source_location": null, "weight": 1.0}, {"source": "passwords_mobile_plan_passwordformscreen", "target": "mobile_cards_plan_c