{"nodes": [{"id": "web_claude_himan_web_workspace", "label": "@himan/web Workspace", "file_type": "concept", "source_file": "web/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Web app is one workspace in an npm workspaces monorepo; npm install must run from the repo root so workspace symlinks to @himan/shared resolve correctly."}, {"id": "web_claude_shared_package_integration", "label": "Shared Package Integration", "file_type": "rationale", "source_file": "web/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Module infrastructure index.ts files re-export repositories/services from @himan/shared/<module> so internal web path aliases stay unchanged while domain code is shared cross-platform."}, {"id": "web_claude_supabase_client_init", "label": "Supabase Client Initialization (initSupabase)", "file_type": "concept", "source_file": "web/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dependency-injection init/get singleton lets the shared package stay platform-agnostic; web passes Vite env vars, mobile passes Expo env vars plus a SecureStore adapter."}, {"id": "web_claude_logger_init", "label": "Logger Initialization (initLogger)", "file_type": "concept", "source_file": "web/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_claude_browser_specific_services", "label": "Browser-Specific Services Stay In Web", "file_type": "rationale", "source_file": "web/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ThumbnailService, CompressionService, InvoicePDFService and LocalNotesStorage depend on DOM/browser APIs, so they are excluded from the shared package whose tsconfig omits the DOM lib."}, {"id": "web_claude_path_aliases", "label": "Web Path Aliases", "file_type": "concept", "source_file": "web/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aliases must be declared in three places (tsconfig.app.json, vite.config.ts, vitest.config.ts) because type-checking, bundling and testing each resolve modules independently."}, {"id": "web_claude_core_alias_gotcha", "label": "@core Alias Points To src/modules/shared", "file_type": "rationale", "source_file": "web/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Directory is named 'shared' but the alias kept the original 'core' name from the initial file-structure scaffold, creating a naming mismatch that must be remembered when adding modules."}, {"id": "web_claude_technology_stack", "label": "Web Technology Stack", "file_type": "concept", "source_file": "web/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_claude_rolldown_vite_swc", "label": "rolldown-vite + SWC Build", "file_type": "concept", "source_file": "web/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rolldown-based Vite fork with @vitejs/plugin-react-swc is chosen for build speed; a consequence is React Compiler cannot be used because it is incompatible with SWC."}, {"id": "web_claude_react_query_strategy", "label": "React Query Data Fetching Strategy", "file_type": "concept", "source_file": "web/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Storage and Cards modules use TanStack Query v5 with staleTime 5min / gcTime 10min; React 19 requires dedupe of react and react-dom in Vite to avoid duplicate React instances."}, {"id": "web_claude_hybrid_local_remote_strategy", "label": "Hybrid Local/Remote Offline-First Strategy", "file_type": "concept", "source_file": "web/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Notes deliberately diverge from React Query: LocalNotesStorage plus NoteSyncService give offline-first editing with dirty-state tracking and conflict resolution, which a pure cache-based fetcher cannot provide."}, {"id": "web_claude_hybridnoterepository", "label": "HybridNoteRepository", "file_type": "concept", "source_file": "web/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_claude_notesyncservice", "label": "NoteSyncService", "file_type": "concept", "source_file": "web/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_claude_localnotesstorage", "label": "LocalNotesStorage", "file_type": "concept", "source_file": "web/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_claude_notes_module", "label": "Notes Module (web)", "file_type": "concept", "source_file": "web/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_claude_passwords_module", "label": "Passwords Module (client-side AES-GCM)", "file_type": "concept", "source_file": "web/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Encryption happens client-side via Web Crypto API with PBKDF2 key derivation from the user ID, so the server never holds plaintext credentials."}, {"id": "web_claude_storage_module", "label": "Storage Module", "file_type": "concept", "source_file": "web/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor