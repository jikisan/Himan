{"nodes": [{"id": "web_prompts_setup_file_structure_simplified_clean_architecture", "label": "Simplified Clean Architecture (Hybrid)", "file_type": "concept", "source_file": "web/prompts/SETUP_FILE_STRUCTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Feature-sliced modules each carry their own domain/infrastructure/presentation triad instead of global layer folders, so a module can be deleted without touching the rest of the app."}, {"id": "web_prompts_setup_file_structure_dependency_rule", "label": "Dependency Rule (inward only)", "file_type": "rationale", "source_file": "web/prompts/SETUP_FILE_STRUCTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Presentation depends on Infrastructure which depends on Domain, never the reverse, keeping business rules independent of React and of the data source."}, {"id": "web_prompts_setup_file_structure_module_independence", "label": "Module Independence", "file_type": "rationale", "source_file": "web/prompts/SETUP_FILE_STRUCTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Modules must not reach into each other's internal structure; each is deletable without breaking others."}, {"id": "web_prompts_setup_file_structure_public_api_barrel", "label": "Barrel Export Public API (index.ts)", "file_type": "rationale", "source_file": "web/prompts/SETUP_FILE_STRUCTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single index.ts per module is the only sanctioned import surface, which is how module boundaries are actually enforced in a codebase with no compile-time visibility modifiers."}, {"id": "web_prompts_setup_file_structure_use_case_driven", "label": "Use Case Driven Business Logic", "file_type": "rationale", "source_file": "web/prompts/SETUP_FILE_STRUCTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each business operation gets its own use case class (one file per use case) so behaviour is testable in isolation from UI and transport."}, {"id": "web_prompts_setup_file_structure_framework_agnostic_domain", "label": "Framework Agnostic Domain Layer", "file_type": "rationale", "source_file": "web/prompts/SETUP_FILE_STRUCTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Domain has no React or UI dependencies, which is what later allowed domain plus infrastructure to be lifted into the shared package for mobile reuse."}, {"id": "web_prompts_setup_file_structure_mappers", "label": "DTO To Entity Mappers", "file_type": "concept", "source_file": "web/prompts/SETUP_FILE_STRUCTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_prompts_setup_file_structure_path_aliases", "label": "TypeScript Path Aliases (scaffold)", "file_type": "concept", "source_file": "web/prompts/SETUP_FILE_STRUCTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Original scaffold mapped @core/* to src/modules/core/*, which is the origin of the later @core-to-shared naming mismatch."}], "edges": [{"source": "web_prompts_setup_file_structure_path_aliases", "target": "web_claude_core_alias_gotcha", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "web/prompts/SETUP_FILE_STRUCTURE.md", "source_location": null, "weight": 1.0}, {"source": "web_prompts_setup_file_structure_path_aliases", "target": "web_claude_path_aliases", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "web/prompts/SETUP_FILE_STRUCTURE.md", "source_location": null