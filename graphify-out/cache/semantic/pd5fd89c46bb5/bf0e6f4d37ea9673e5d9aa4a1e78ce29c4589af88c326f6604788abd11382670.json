ocery_redesign", "target": "mobile_claude_realtime", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/grocery-redesign-plan.md", "source_location": null, "weight": 1.0}, {"source": "docs_grocery_redesign_plan_client_generated_uuids", "target": "docs_superpowers_plans_2026_08_01_grocery_friends_friendships_table", "relation": "conceptually_related_to", "confidence": "AMBIGUOUS", "confidence_score": 0.25, "source_file": "docs/grocery-redesign-plan.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "offline_sync_write_path", "label": "Offline Sync Write Path (optimistic to drained)", "nodes": ["docs_grocery_redesign_plan_syncqueue", "docs_grocery_redesign_plan_syncengine", "docs_grocery_redesign_plan_sqlitesyncstorage", "docs_grocery_redesign_plan_lww_conflict_resolution", "docs_grocery_redesign_plan_client_generated_uuids", "docs_grocery_redesign_plan_auth_hardening"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/grocery-redesign-plan.md"}]}