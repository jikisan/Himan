{"nodes": [{"id": "mobile_claude_expo_router", "label": "Expo Router File-Based Routing", "file_type": "concept", "source_file": "mobile/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Route groups: (auth) public, (app) protected. experiments.typedRoutes makes routes type-checked. Deep link scheme himan://."}, {"id": "mobile_claude_protected_route_guard", "label": "Protected Route Guard Pattern", "file_type": "rationale", "source_file": "mobile/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "app/(app)/_layout.tsx returns null while loading and redirects to /(auth)/login when there is no user \u2014 guarding at the group layout rather than per screen."}, {"id": "mobile_claude_metro_shared_resolution", "label": "Metro Shared-Package Resolution", "file_type": "rationale", "source_file": "mobile/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Metro must remap .js to .ts for shared package internals and set resolver.unstable_enablePackageExports = true, because @himan/shared ships raw TypeScript with subpath exports and no build step."}, {"id": "mobile_claude_nativewind", "label": "NativeWind v4 Styling", "file_type": "concept", "source_file": "mobile/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "mobile_claude_styling_conventions", "label": "Mobile Styling Conventions", "file_type": "rationale", "source_file": "mobile/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "bg-gray-50 screens, bg-white containers, rounded-2xl border-gray-200, three-level text hierarchy, indigo-600 accent, SafeAreaView on every screen, KeyboardAvoidingView with platform-conditional behavior on forms."},