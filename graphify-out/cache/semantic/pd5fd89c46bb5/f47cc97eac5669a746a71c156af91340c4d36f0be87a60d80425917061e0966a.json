{"nodes": [{"id": "mobile_google_signin_plan_google_signin", "label": "Native Google Sign-In via ID Token", "file_type": "rationale", "source_file": "mobile/GOOGLE_SIGNIN_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "@react-native-google-signin/google-signin plus supabase.auth.signInWithIdToken gives Google's own native sign-in sheet instead of a webview flow; requires expo prebuild and an Expo config plugin."}, {"id": "mobile_google_signin_plan_mobileauthrepository", "label": "MobileAuthRepository", "file_type": "concept", "source_file": "mobile/GOOGLE_SIGNIN_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implements the shared AuthRepository interface directly; every method is platform-agnostic Supabase except signInWithGoogle. Web is untouched \u2014 mobile gets its own implementation rather than branching the shared one."}, {"id": "mobile_google_signin_plan_initsupabase", "label": "initSupabase authStorage Extension", "file_type": "rationale", "source_file": "mobile/GOOGLE_SIGNIN_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An optional authStorage param is the only shared-package change: it spreads into the auth options only when provided, so web (which passes nothing) is byte-for-byte unchanged. Risk assessed as near zero."}, {"id": "mobile_google_signin_plan_exposecurestoreadapter", "label": "ExpoSecureStoreAdapter", "file_type": "concept", "source_file": "mobile/GOOGLE_SIGNIN_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three-method adapter mapping getItem/setItem/removeItem onto expo-secure-store, so Supabase persists the session in the device keychain instead of localStorage."}, {"id": "mobile_google_signin_plan_authprovider", "label": "Mobile AuthProvider / useAuth", "file_type": "concept", "source_file": "mobile/GOOGLE_SIGNIN_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Subscribes to onAuthStateChange and seeds from getSession; deliberately omits the web version's URL-hash parsing, which has no meaning on native."}, {"id": "mobile_google_signin_plan_uselogin", "label": "useLogin Hook", "file_type": "concept", "source_file": "mobile/GOOGLE_SIGNIN_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owns loading and error state so the login screen can drop its local stubs; routes to /(app)/dashboard via router.replace on success."}, {"id": "mobile_google_signin_plan_protected_routing", "label": "Auth-Driven Route Restructure", "file_type": "concept", "source_file": "mobile/GOOGLE_SIGNIN_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Splits routes into (auth) and (app) groups so auth state, not button handlers, controls navigation; index.tsx redirects based on the resolved user."}], "edges": [{"source": "mobile_google_signin_plan_mobileauthrepository", "target": "mobile_google_signin_plan_google_signin", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mobile/GOOGLE_SIGNIN_PLAN.md", "source_location": null, "weight": 1.0}, {"source": "mobile_google_signin_plan_mobileauthrepository", "target": "claude_supabase_client_pattern", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mobile/GOOGLE_SIGNIN_PLAN.md", "source_location": null, "weight": 1.0}, {"source": "mobile_google_signin_plan_initsupabase", "target": "mobile_google_signin_plan_exposecurestoreadapter", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mobile/GOOGLE_SIGNIN_PLAN.md"