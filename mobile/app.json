{
  "expo": {
    "name": "Himan",
    "slug": "himan",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "himan",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.himan.app",
      "buildNumber": "2",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.428840355906-9j1i82herkr76nhaoq0urld17rq0onh0"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.428840355906-9j1i82herkr76nhaoq0urld17rq0onh0"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "4Y5UX7K5DW"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.himan.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Himan uses your photos so you can attach ID photos and payment screenshots.",
          "cameraPermission": "Himan uses the camera so you can take a photo of an ID or a receipt."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "13d47930-b61b-43e1-96a8-9b3f1586b7f7"
      }
    }
  }
}
