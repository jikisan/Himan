{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path Aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@core/*": ["src/modules/shared/*"],
      "@auth/*": ["src/modules/auth/*"],
      "@dashboard/*": ["src/modules/dashboard/*"],
      "@notes/*": ["src/modules/notes/*"],
      "@passwords/*": ["src/modules/passwords/*"],
      "@cards/*": ["src/modules/cards/*"],
      "@storage/*": ["src/modules/storage/*"],
      "@settings/*": ["src/modules/settings/*"],
      "@subscriptions/*": ["src/modules/subscriptions/*"],
      "@invoice-generator/*": ["src/modules/invoice-generator/*"],
      "@grocery/*": ["src/modules/grocery/*"],
      "@career/*": ["src/modules/career/*"],
      "@profile/*": ["src/modules/profile/*"],
      "@app/*": ["src/app/*"],
      "@modules/*": ["src/modules/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}
